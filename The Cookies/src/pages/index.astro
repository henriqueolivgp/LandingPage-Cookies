---
import Navbar from "../components/navbar.astro";
import InfoBanner from "@/components/infoBanner.astro";
import Layout from "../layouts/Layout.astro";
import Banner from "@/components/banner.astro";
import Gallary from "@/components/gallery.astro";
import LogoLoop from "@/components/logoLoop.jsx";
import Features from "../components/features.astro";
import OpeningHours from "../components/horario.astro";
import Footer from "@/components/footer.astro";

const metodosPagamento = [
  { src: "https://upload.wikimedia.org/wikipedia/commons/4/41/Visa_Logo_2021.svg", alt: "VISA" },
  { src: "https://upload.wikimedia.org/wikipedia/commons/b/b7/MasterCard_Logo.svg", alt: "Mastercard" },
  { src: "https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg", alt: "Apple Pay" },
  { src: "https://upload.wikimedia.org/wikipedia/commons/4/49/Maestro_logo.svg", alt: "Maestro" },
  { src: "https://upload.wikimedia.org/wikipedia/commons/d/de/MB_WAY_logo.png", alt: "MBWay" },
  { src: "https://upload.wikimedia.org/wikipedia/commons/e/e0/Contactless_icon.svg", alt: "Contactless" },
];
---

<Layout>
  <InfoBanner />
  <Navbar />
  
  <main class="w-full overflow-hidden">
    <Banner />
    <Gallary />

    <section class="py-16 bg-orange-50/50 border-t border-orange-100">
      <div class="container mx-auto px-4 space-y-16">
        
        <Features />

        <div class="max-w-2xl mx-auto border-t border-orange-200/60"></div>

        <OpeningHours />

        <div class="text-center pt-4">
          <p class="text-xs font-bold tracking-widest text-orange-400 uppercase mb-8">
            Métodos de pagamento aceites
          </p>
          <div class="w-full mx-auto">
            <LogoLoop
              client:load
              logos={metodosPagamento}
              speed={30}
              gap={40}
              logoHeight={32}
              className="opacity-60 hover:opacity-100 transition-opacity"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>