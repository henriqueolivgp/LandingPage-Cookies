---
// src/components/features.astro

const comodidades = [
  {
    nome: "Acessível",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="4" r="1"/><path d="m18 19 1-7-6 1"/><path d="m5 8 3-3 5.5 3-2.36 3.5"/><path d="M4.24 14.5a5 5 0 0 0 6.88 6"/><path d="M13.76 17.5a5 5 0 0 0-6.88-6"/></svg>`,
  },
  {
    nome: "Catering",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-.5"/><path d="M5 13.52c-.62-.17-1.3-.3-2-.4"/><path d="M21 13.12c-.7.1-1.38.23-2 .4"/><path d="M12 2v2"/><path d="M3.2 8.7a10.8 10.8 0 0 1 17.6 0"/></svg>`,
  },
  {
    nome: "Esplanada",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12a10.06 10.06 1 0 0-20 0Z"/><path d="M12 12v8"/><path d="M9 20h6"/><path d="M4.2 8h15.6"/></svg>`,
  },
  {
    nome: "Estacionamento",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>`,
  },
  {
    nome: "Takeaway",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    nome: "Wi-Fi Grátis",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.82a15 15 0 0 1 20 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg>`,
  },
  {
    nome: "Pet Friendly",
    icon: `<svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .08.703 1.725 1.722 3.656 1 1.261-.467 1.95-1.656 1.95-2.828"/><path d="M14 5.172C14 3.782 15.577 2.679 17.5 3c2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.467-1.95-1.656-1.95-2.828"/><path d="M7 9c0-1.105 2.239-2 5-2s5 .895 5 2v4.5C17 15.433 14.761 17 12 17s-5-1.567-5-3.5V9Z"/><path d="M12 13v4"/><path d="M9 13l3 4 3-4"/></svg>`,
  },
];
---

<div class="max-w-7xl mx-auto px-4 w-full">
  <div class="flex flex-wrap justify-center gap-8 md:gap-12 lg:justify-between items-center">
    {comodidades.map((item) => (
      <div class="flex flex-col items-center gap-3 text-orange-950 group">
        <div class="w-14 h-14 flex items-center justify-center text-orange-900 transition-transform duration-300 group-hover:-translate-y-1">
          <Fragment set:html={item.icon} />
        </div>
        <span class="text-sm font-medium tracking-wide">{item.nome}</span>
      </div>
    ))}
  </div>
</div>