---
// src/components/HorarioMapa.astro
const horarios = [
  { dia: "Segunda - Sexta", hora: "10:00 - 18:30" },
  { dia: "Sábado", hora: "10:00 - 18:00" },
  { dia: "Domingo", hora: "Encerrado" },
];

// Substitui este link pelo link do Google Maps da tua loja:
// 1. Vai ao Google Maps > Pesquisa a tua morada > Partilhar > Incorporar um mapa > Copiar HTML
const googleMapsSrc = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3000!2d-9.1393!3d38.7223!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzfCsDQzJzIwLjMiTiA5wrAwOCcyMS41Ilc!5e0!3m2!1spt-PT!2spt!4v1600000000000!5m2!1spt-PT!2spt";
---

<section class="max-w-6xl mx-auto px-4 py-12">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
    <div class="bg-white rounded-3xl p-8 shadow-sm border border-orange-100 flex flex-col justify-center">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-orange-950">Horário</h2>
        <span class="flex items-center gap-2 text-green-600 font-semibold bg-green-50 px-3 py-1 rounded-full text-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Aberto Agora
        </span>
      </div>

      <div class="space-y-4">
        {horarios.map((item) => (
          <div class="flex justify-between items-center py-3 border-b border-orange-50 last:border-0">
            <span class="font-medium text-orange-800">{item.dia}</span>
            <span class="text-orange-950 font-bold">{item.hora}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-3xl shadow-sm border border-orange-100 overflow-hidden h-full min-h-75">
      <iframe
        src={googleMapsSrc}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Localização da Gotas de Amor"
      ></iframe>
    </div>
  </div>
</section>