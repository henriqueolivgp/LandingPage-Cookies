<section class="bg-orange-50 lg:grid lg:place-content-center">
<style>
    @keyframes crescerCirculo {
      from {
        transform: scale(0);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    @keyframes entrarCookie {
      0% {
        transform: translateX(600px);
        opacity: 0;
      }
      30% {
        transform: translateX(600px);
        opacity: 0;
      }
      70% {
        transform: translateX(100px);
        opacity: 0;
      }
      85% {
        transform: translateX(20px);
        opacity: 0.6;
      }
      100% {
        transform: translateX(0px);
        opacity: 1;
      }
    }

    @keyframes girar {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    .animate-circulo {
      animation: crescerCirculo 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    .animate-cookie {
      animation:
        entrarCookie 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 1.5s both,
        girar 8s linear 2.7s infinite;
    }
  </style>

  <div
    class="mx-auto w-full max-w-7xl px-4 h-screen sm:px-6 md:grid md:grid-cols-2 md:items-center md:gap-8 lg:px-8"
  >
    <div class="max-w-prose text-left">
      <h1 class="text-4xl font-bold text-orange-950 sm:text-5xl">
        Cookies artesanais com muito
        <strong class="text-orange-600 font-extrabold"> recheio e amor </strong>
      </h1>

      <p class="mt-4 text-base text-pretty text-orange-800 sm:text-lg/relaxed">
        Esquece tudo o que sabes sobre cookies. As nossas fornadas são
        preparadas diariamente com ingredientes locais e chocolate belga,
        garantindo aquele centro derretido que tu mereces.
      </p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          class="inline-block rounded-lg border border-orange-600 bg-orange-600 px-7 py-3.5 font-semibold text-white shadow-md transition-colors hover:bg-orange-700 focus:ring-4 focus:ring-orange-300"
          href="#"
        >
          Pedir Agora
        </a>

        <a
          class="inline-block rounded-lg border border-orange-200 bg-white px-7 py-3.5 font-semibold text-orange-900 shadow-sm transition-colors hover:bg-orange-100 hover:text-orange-950 focus:ring-4 focus:ring-orange-100"
          href="#"
        >
          Ver Sabores
        </a>
      </div>
    </div>

    <div
      class="w-96 h-96 flex justify-center items-center rounded-full bg-amber-700 animate-circulo"
    >
      <img
        class="w-80 h-80 animate-cookie hover:[animation-play-state:paused]"
        src="/cookie.png"
        alt="cookie"
      />
    </div>
  </div>
</section>
